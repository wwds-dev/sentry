<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template only. The app writes the real plist to
  ~/Library/LaunchAgents/com.sentinel.sentry.watch.plist via sentry/watchd.py,
  filling in the interpreter path, this main.py, the interval and the log path.
  Kept here for reference and manual installation.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.sentinel.sentry.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/.venv/bin/python</string>
    <string>/path/to/agents/sentry/main.py</string>
    <string>--headless</string>
  </array>
  <key>StartInterval</key>    <integer>300</integer>
  <key>RunAtLoad</key>        <true/>
  <key>ProcessType</key>      <string>Background</string>
  <key>StandardOutPath</key>  <string>/path/to/data/sentry/watch.log</string>
  <key>StandardErrorPath</key><string>/path/to/data/sentry/watch.log</string>
</dict>
</plist>
